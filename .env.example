# ============================================================
#  AI小说平台 — 环境变量模板（可安全提交到版本控制）
#  使用方式: 复制为 .env 并填入真实值
# ============================================================

# ── LLM API Keys ──────────────────────────────────────────
# DeepSeek (国产低价) — 注册获取: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (备用) — 注册获取: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM 模式: auto | deepseek | openai | mock
LLM_MODE=auto

# ── 部署服务器 ─────────────────────────────────────────────
DEPLOY_SERVER=your_server_ip
DEPLOY_USER=your_ssh_user
DEPLOY_PASSWORD=your_ssh_password

# SSH 密钥路径 (Windows本地)
SSH_KEY_PATH=path/to/your/ssh/key.pem

# ── 应用配置 ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
DATA_DIR=./data
