# ============================================================
#  AI小说平台 — 环境变量模板（可安全提交到版本控制）
#  使用方式: 复制为 .env 并填入真实值
# ============================================================

# ── LLM API Keys ──────────────────────────────────────────
# 选择你使用的Provider，设置对应的API Key和Base URL
# LLM_MODE: auto | mock | deepseek | openai | kimi | minimax | zhipu | qwen | hunyuan | doubao | custom

# DeepSeek (推荐，便宜) — https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI (备用) — https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Kimi / Moonshot AI — https://platform.moonshot.cn
# KIMI_API_KEY=your_kimi_api_key_here
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k

# MiniMax — https://platform.minimax.chat
# MINIMAX_API_KEY=your_minimax_api_key_here
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=abab6-chat

# 智谱GLM — https://open.bigmodel.cn
# ZHIPU_API_KEY=your_zhipu_api_key_here
# ZHIPU_BASE_URL=https://open.bigmodel.cn/v1
# ZHIPU_MODEL=glm-4-flash

# 通义千问 — https://dashscope.aliyuncs.com
# QWEN_API_KEY=your_qwen_api_key_here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-turbo

# 腾讯混元 — https://cloud.tencent.com
# HUNYUAN_API_KEY=your_hunyuan_api_key_here
# HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com
# HUNYUAN_MODEL=hunyuan

# 字节豆包 — https://console.volcengine.com
# DOUBAO_API_KEY=your_doubao_api_key_here
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-pro-32k

# 自定义OpenAI兼容端点
# CUSTOM_API_KEY=your_custom_api_key_here
# CUSTOM_BASE_URL=https://your-custom-endpoint.com/v1
# CUSTOM_MODEL=your-model

# ── LLM 模式配置 ─────────────────────────────────────────
# auto: 自动选择（按 DeepSeek > Kimi > MiniMax > 智谱 > 千问 > OpenAI 优先级）
# mock: 使用模拟LLM（免费，无需API Key）
# 指定: deepseek | openai | kimi | minimax | zhipu | qwen | hunyuan | doubao | custom
LLM_MODE=auto

# ── 部署服务器 ─────────────────────────────────────────────
DEPLOY_SERVER=your_server_ip
DEPLOY_USER=your_ssh_user
DEPLOY_PASSWORD=your_ssh_password

# SSH 密钥路径 (Windows本地)
SSH_KEY_PATH=path/to/your/ssh/key.pem

# ── 应用配置 ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
DATA_DIR=./data
